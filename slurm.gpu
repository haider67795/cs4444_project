#! /bin/bash
#SBATCH --gres=gpu:1
#SBATCH --constraint="h100_94gb"
#SBATCH -n 1
#SBATCH -t 04:00:00
#SBATCH -p gpu
#SBATCH --mem=16G

module load cuda/12.8.1
nvidia-smi
make clean
make 

